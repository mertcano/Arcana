# ---- Server-side only (never commit real values) ----
# Anthropic API key for generating answers
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-3-5-sonnet-latest)
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Secret used to sign one-time unlock tokens (any long random string)
UNLOCK_SECRET=

# ---- Public (safe to expose) ----
# YOUR Arc Testnet wallet that receives paywall payments
NEXT_PUBLIC_TREASURY_ADDRESS=0xYourTestnetWalletAddress
# ERC-20 USDC on Arc Testnet (verify on docs.arc.io)
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Price per deep answer, in USDC
NEXT_PUBLIC_PRICE_USDC=0.5
